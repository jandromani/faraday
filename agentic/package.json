{
  "name": "@faraday/agentic",
  "version": "0.99.7",
  "private": true,
  "description": "FARADAY signed journal recovery, Vault KVv2 and isolated MCP trust-boundary pilot",
  "type": "module",
  "bin": {
    "faraday": "./bin/faraday.js",
    "faraday-lab-server": "./bin/faraday-lab-server.js"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=2 tests/*.test.js",
    "smoke": "node bin/faraday.js demo",
    "test:all": "npm test && npm run test:python && npm run smoke && npm run lab && npm run workflow && npm run workflow:eval && npm run authority && npm run authority:eval && npm run pilot && npm run pilot:eval && npm pack --dry-run && npm run release:audit && npm run timemachine:smoke && npm run benchmark:smoke && npm run oauth:eval && npm run trust:test && npm run boundary:test && npm run recovery:test",
    "lab": "node bin/faraday.js lab run",
    "lab:gate": "node bin/faraday.js lab run --fail-on-gap",
    "compat": "node bin/faraday.js compat --root .",
    "authority": "node bin/faraday.js authority demo",
    "lab:docker": "sh scripts/docker-smoke.sh",
    "authority:eval": "node bin/faraday.js authority eval --limit 100",
    "pilot": "node bin/faraday.js pilot demo",
    "pilot:docker": "sh scripts/docker-pilot-smoke.sh",
    "pilot:eval": "node bin/faraday.js pilot eval --limit 100",
    "security:fuzz": "node --test tests/fuzz.test.js",
    "release:audit": "node scripts/release-audit.mjs",
    "timemachine:smoke": "node scripts/timemachine-smoke.mjs",
    "benchmark:smoke": "node bin/faraday.js benchmark --iterations 25",
    "test:python": "node scripts/test-python.mjs",
    "workflow": "node bin/faraday.js workflow demo",
    "workflow:eval": "node bin/faraday.js workflow eval --limit 100",
    "mcp:probe:test": "node --test tests/mcp-live-probe.test.js",
    "onboard:smoke": "node scripts/onboarding-smoke.mjs",
    "closure:report": "node scripts/epic-closure-report.mjs",
    "closure:test": "node --test tests/closure-acceptance.test.js",
    "oauth:eval": "node scripts/oauth-attack-evals.mjs",
    "oauth:test": "node --test tests/mcp-oauth-resource.test.js",
    "architecture:test": "node --test tests/architecture.test.js tests/assurance-gates.test.js tests/otel-mcp.test.js tests/gateway-policy-port.test.js",
    "assurance:ci": "node scripts/assurance-ci.mjs",
    "trust:test": "node --test tests/oauth-revocations.test.js tests/secret-file-provider.test.js tests/evidence-checkpoint.test.js tests/mcp-oauth-resource.test.js",
    "boundary:test": "node --test tests/vault-kv2-secret-provider.test.js tests/deployment-boundary.test.js",
    "recovery:test": "node --test tests/journal-backup.test.js",
    "evidence:verify": "node scripts/verify-evidence.mjs",
    "fencing:postgres:smoke": "node scripts/postgres-fencing-smoke.mjs"
  },
  "license": "Apache-2.0",
  "exports": {
    "./contracts": "./lib/contracts.js",
    "./ai-free": "./lib/ai-free.js",
    "./http-bridge": "./lib/http-bridge.js",
    "./shield": "./lib/security-policy.js",
    "./egress": "./lib/egress-guard.js",
    "./lab": "./lib/lab.js",
    "./trust-diff": "./lib/trust-diff.js",
    "./mcp-live-probe": "./lib/mcp-live-probe.js",
    "./compatibility": "./lib/compatibility.js",
    "./authority": "./lib/authority.js",
    "./gateway": "./lib/authority-gateway.js",
    "./authority-fixture": "./lib/authority-fixture.js",
    "./pilot-mcp": "./lib/pilot-mcp.js",
    "./vault-kv2-secret-provider": "./lib/vault-kv2-secret-provider.js",
    "./pilot-receipts": "./lib/pilot-receipts.js",
    "./evidence-checkpoint": "./lib/evidence-checkpoint.js",
    "./pilot-backend-attestation": "./lib/backend-attestation.js",
    "./pilot-reconcile": "./lib/pilot-reconcile.js",
    "./pilot-backend": "./lib/pilot-backend.js",
    "./approvals": "./lib/approvals.js",
    "./sentinel": "./lib/sentinel.js",
    "./budget": "./lib/budget.js",
    "./memory-guard": "./lib/memory-guard.js",
    "./timemachine": "./lib/timemachine.js",
    "./benchmarks": "./lib/benchmarks.js",
    "./recovery-inspector": "./lib/recovery-inspector.js",
    "./journal-backup": "./lib/journal-backup.js",
    "./release-evidence": "./lib/release-evidence.js",
    "./adapter-ingest": "./lib/adapter-ingest.js",
    "./workflow": "./lib/workflow-e2e.js",
    "./workflow-trace": "./lib/workflow-trace.js",
    "./workflow-free-planner": "./lib/workflow-free-planner.js",
    "./mcp-oauth-resource": "./lib/mcp-oauth-resource.js",
    "./connect": "./packages/connect/index.js",
    "./authority-suite": "./packages/authority/index.js",
    "./evidence": "./packages/evidence/index.js",
    "./lab-suite": "./packages/lab/index.js",
    "./otel-mcp": "./lib/otel-mcp.js",
    "./assurance-gates": "./lib/assurance-gates.js",
    "./gateway-policy-port": "./lib/gateway-policy-port.js",
    "./oauth-revocations": "./lib/oauth-revocations.js",
    "./secret-file-provider": "./lib/secret-file-provider.js",
    "./deployment-boundary": "./lib/deployment-boundary.js",
    "./authority-adapter-bridge": "./lib/authority-adapter-bridge.js",
    "./verified-evidence": "./lib/verified-evidence.js",
    "./r2-evidence-gate": "./lib/r2-evidence-gate.js",
    "./r3-runtime-gate": "./lib/r3-runtime-gate.js",
    "./r4-adapter-contract": "./lib/r4-adapter-contract.js",
    "./postgres-fencing-protocol": "./lib/postgres-fencing-protocol.js"
  },
  "files": [
    "bin",
    "lib",
    "web",
    "README.md",
    "SECURITY.md",
    "docs",
    "scripts",
    "deploy",
    "python",
    "packages"
  ]
}
